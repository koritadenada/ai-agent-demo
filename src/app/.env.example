# Local development only (npm run dev). The deployed app gets these from resources/app.yml.
DATABRICKS_CONFIG_PROFILE=your_cli_profile
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_SERVING_ENDPOINT_NAME=databricks-claude-sonnet-5-5
# one MLflow experiment per agent (its prompt and its traces): portcall-port-assistant, -quote-negotiator, -timeline-summarizer
PORT_ASSISTANT_EXPERIMENT_ID=your_experiment_id
QUOTE_NEGOTIATOR_EXPERIMENT_ID=your_experiment_id
TIMELINE_SUMMARIZER_EXPERIMENT_ID=your_experiment_id
DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id
DATABRICKS_VOLUME_FILES=/Volumes/your_catalog/portcall_landing/documents
# the three Genie agents (resources/agents.genie.yml); DATABRICKS_GENIE_SPACE_ID is the genie plugin default
DATABRICKS_GENIE_SPACE_ID=your_port_costs_space_id
PORT_COSTS_SPACE_ID=your_port_costs_space_id
DA_AUDIT_SPACE_ID=your_da_audit_space_id
DA_OPERATIONS_SPACE_ID=your_da_operations_space_id
GOLD_SCHEMA=your_catalog.portcall_gold
SILVER_SCHEMA=your_catalog.portcall_silver
APP_SCHEMA=your_catalog.portcall_app
PROMPT_ALIAS=production
# Lakebase (chat history): databricks postgres list-endpoints projects/portcall-agents/branches/production
LAKEBASE_ENDPOINT=projects/portcall-agents/branches/production/endpoints/primary
PGHOST=your_lakebase_host
PGDATABASE=databricks_postgres
PGPORT=5432
PGSSLMODE=require
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=portcall-agents
